# Copy to .env and fill in the key. Never commit .env.

# --- OpenRouter ---------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Models (pinned, dated slugs only — never "~latest") ----------------
MODEL_MAIN=deepseek/deepseek-v4-flash-0731
MODEL_PRO=deepseek/deepseek-v4-pro-0813
MODEL_COMPARE=deepseek/deepseek-v3.2

# --- Provider pinning (one host per model, no silent fallbacks) ---------
PROVIDER_MAIN=deepinfra/fp8
PROVIDER_PRO=deepseek
PROVIDER_COMPARE=deepinfra/fp4
ALLOW_FALLBACKS=false

# --- Sampling -----------------------------------------------------------
TEMPERATURE=1.0
MAX_TOKENS=4000
REASONING=on
# Leave empty to use the model default effort, as Knecht et al. did
REASONING_EFFORT=

# --- Budget guard (USD) -------------------------------------------------
BUDGET_TOTAL_USD=45
BUDGET_PER_RUN_USD=0.75

# --- Logging ------------------------------------------------------------
LOG_DIR=runs
